{
  "name": "navi-knowledge",
  "version": "0.1.1",
  "type": "module",
  "description": "Navi 认知 MCP server —— 让 Claude Code / Codex / Cursor 等工具通过 MCP 查询、更新 Navi 认知库，说「记住xxx」即可写入 Navi「记忆」",
  "license": "MIT",
  "author": "HduSy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HduSy/navi.git",
    "directory": "packages/navi-knowledge"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "navi",
    "memory",
    "knowledge"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.js",
  "bin": {
    "navi-knowledge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "start": "node ./dist/index.js",
    "dev": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  }
}
